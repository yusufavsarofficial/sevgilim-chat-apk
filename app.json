{
  "expo": {
    "name": "Puantaj Maaş Hesap",
    "slug": "puantaj-maas-apk",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1220"
    },
    "android": {
      "package": "com.yusuf.puantajmaashesap",
      "versionCode": 11,
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f766e"
      }
    },
    "extra": {
      "apiBaseUrl": "https://puantaj-maas-backend.onrender.com"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=change-this-to-a-random-64-character-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$replace-with-bcrypt-hash
# Optional legacy fallback only. Main registration flow uses registration_invite_keys.
# REGISTER_INVITE_KEY_HASH=replace-with-sha256-hex-hash
PG_SSL_REJECT_UNAUTHORIZED=true
PORT=3000
CORS_ORIGIN=https://puantaj-maas-backend.onrender.com,http://localhost:8081,http://localhost:19006
UPLOADS_DIR=../uploads

{
  "name": "puantaj-maas-apk",
  "version": "1.14.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:payroll": "node scripts/test-payroll.js",
    "test:payroll:ts": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" tests/payroll.test.ts",
    "render:env": "node scripts/generate-render-env.js",
    "render:health": "node scripts/check-backend-health.js",
    "build": "npm run typecheck && expo export --platform android --output-dir dist",
    "android:prebuild": "npx expo prebuild --platform android",
    "android:apk": "node scripts/build-apk.js",
    "android:apk:copy": "node scripts/copy-apk.js",
    "apk": "npm run android:apk && npm run android:apk:copy",
    "apk:release": "npm run apk",
    "check": "npx expo-doctor && npx tsc --noEmit",
    "build:android:apk": "npm run apk",
    "build:android:aab": "npm run apk:release"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.24",
    "expo-crypto": "~55.0.15",
    "expo-device": "~55.0.17",
    "expo-file-system": "~55.0.20",
    "expo-image-picker": "~55.0.20",
    "expo-navigation-bar": "~55.0.13",
    "expo-print": "~55.0.15",
    "expo-sharing": "~55.0.19",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
